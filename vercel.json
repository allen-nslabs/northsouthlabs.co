{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/ai/archive/:path*",
      "destination": "https://ai-archive-allen-nslabs-projects.vercel.app/ai/archive/:path*"
    },
    {
      "source": "/ai/archive",
      "destination": "https://ai-archive-allen-nslabs-projects.vercel.app/ai/archive/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ai/archive/",
      "destination": "/ai/archive",
      "permanent": false
    }
  ]
}
